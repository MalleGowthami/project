class Solution {
    public boolean isNegativeWeightCycle(int V, int[][] edges) {
        
        int[] dist = new int[V];

        // Relax all edges V times
        for (int i = 0; i < V; i++) {
            
            boolean updated = false;

            for (int[] edge : edges) {
                int u = edge[0];
                int v = edge[1];
                int w = edge[2];

                if (dist[v] > dist[u] + w) {
                    dist[v] = dist[u] + w;
                    updated = true;

                    // Update on V-th iteration means
                    // negative weight cycle exists
                    if (i == V - 1) {
                        return true;
                    }
                }
            }

            // No changes -> no negative cycle
            if (!updated) {
                break;
            }
        }

        return false;
    }
}
