class Solution {

    public int countMinOperations(int[] arr) {

        int count = 0;

        while (true) {

            boolean allZero = true;

            // Reduce odd numbers
            for (int i = 0; i < arr.length; i++) {
                if (arr[i] % 2 == 1) {
                    arr[i]--;
                    count++;
                }

                if (arr[i] != 0)
                    allZero = false;
            }

            if (allZero)
                break;

            // Divide all elements by 2
            for (int i = 0; i < arr.length; i++) {
                arr[i] /= 2;
            }

            count++;
        }

        return count;
    }
}
