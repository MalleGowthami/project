class Solution {

    public String compress(String s) {

        if (s.length() == 1) {
            return s;
        }

        char[] stack = s.toCharArray();
        int top = s.length() - 1;

        StringBuilder result = new StringBuilder();

        while (top >= 0) {

            int len = top + 1;

            // If the current string has even length,
            // check whether its two halves are equal.
            if (len % 2 == 0) {

                int half = len / 2;
                boolean same = true;

                for (int i = 0; i < half; i++) {
                    if (stack[i] != stack[i + half]) {
                        same = false;
                        break;
                    }
                }

                if (same) {
                    // Keep only the first half and add '*'
                    top = half - 1;
                    result.append('*');
                    continue;
                }
            }

            // If it cannot be compressed, keep the last character.
            result.append(stack[top]);
            top--;
        }

        return result.reverse().toString();
    }
}
