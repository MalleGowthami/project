import java.util.*;

class Solution {

    public ArrayList<ArrayList<Integer>> formCoils(int n) {

        int N = 4 * n;

        ArrayList<Integer> coil1 = new ArrayList<>();
        ArrayList<Integer> coil2 = new ArrayList<>();

        // ==========================================
        // FIRST COIL
        // Direction: Down -> Right -> Up -> Left
        // ==========================================

        for (int k = 0; k < N; k += 2) {

            int top = k;
            int bottom = N - 1 - k;
            int left = k;
            int right = N - 2 - k;

            if (top > bottom || left > right) {
                break;
            }

            // Down
            for (int i = top; i <= bottom; i++) {
                coil1.add(i * N + left + 1);
            }

            // Right
            for (int j = left + 1; j <= right; j++) {
                coil1.add(bottom * N + j + 1);
            }

            // Up
            for (int i = bottom - 1; i >= top + 1; i--) {
                coil1.add(i * N + right + 1);
            }

            // Left
            for (int j = right - 1; j >= left + 2; j--) {
                coil1.add((top + 1) * N + j + 1);
            }
        }

        // ==========================================
        // SECOND COIL
        // Direction: Up -> Left -> Down -> Right
        // ==========================================

        for (int k = 0; k < N; k += 2) {

            int top = k;
            int bottom = N - 1 - k;
            int left = k + 1;
            int right = N - 1 - k;

            if (top > bottom || left > right) {
                break;
            }

            // Up
            for (int i = bottom; i >= top; i--) {
                coil2.add(i * N + right + 1);
            }

            // Left
            for (int j = right - 1; j >= left; j--) {
                coil2.add(top * N + j + 1);
            }

            // Down
            for (int i = top + 1; i <= bottom - 1; i++) {
                coil2.add(i * N + left + 1);
            }

            // Right
            for (int j = left + 1; j <= right - 2; j++) {
                coil2.add((bottom - 1) * N + j + 1);
            }
        }

        ArrayList<ArrayList<Integer>> result = new ArrayList<>();

        result.add(coil1);
        result.add(coil2);

        return result;
    }
}
