
class Solution {
    public ArrayList<Integer> findPairs(int[] arr) {

        int n = arr.length;

        HashMap<Integer, int[]> map = new HashMap<>();

        int[] best = {-1, -1, -1, -1};

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {

                int sum = arr[i] + arr[j];

                if (map.containsKey(sum)) {

                    int[] prev = map.get(sum);

                    int a = prev[0];
                    int b = prev[1];

                    if (a != i && a != j &&
                        b != i && b != j) {

                        int[] current = {a, b, i, j};

                        if (best[0] == -1 ||
                            compare(current, best) < 0) {
                            best = current;
                        }
                    }

                } else {
                    map.put(sum, new int[]{i, j});
                }
            }
        }

        ArrayList<Integer> ans = new ArrayList<>();

        for (int x : best) {
            ans.add(x);
        }

        return ans;
    }

    private int compare(int[] x, int[] y) {
        for (int i = 0; i < 4; i++) {
            if (x[i] != y[i]) {
                return x[i] - y[i];
            }
        }
        return 0;
    }
}
