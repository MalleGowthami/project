class Solution {
    public int countSubarray(int[] arr, int l, int r) {
        int n = arr.length;

        long[] prefix = new long[n + 1];
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + arr[i];
        }

        return (int) mergeSort(prefix, 0, n + 1, l, r);
    }

    private long mergeSort(long[] prefix, int left, int right, int l, int r) {
        if (right - left <= 1) return 0;

        int mid = (left + right) / 2;
        long count = mergeSort(prefix, left, mid, l, r)
                   + mergeSort(prefix, mid, right, l, r);

        int low = mid, high = mid;
        for (int i = left; i < mid; i++) {
            while (low < right && prefix[low] - prefix[i] < l) low++;
            while (high < right && prefix[high] - prefix[i] <= r) high++;
            count += high - low;
        }

        long[] temp = new long[right - left];
        int i = left, j = mid, k = 0;

        while (i < mid && j < right) {
            if (prefix[i] <= prefix[j]) {
                temp[k++] = prefix[i++];
            } else {
                temp[k++] = prefix[j++];
            }
        }

        while (i < mid) temp[k++] = prefix[i++];
        while (j < right) temp[k++] = prefix[j++];

        System.arraycopy(temp, 0, prefix, left, temp.length);

        return count;
    }
}
