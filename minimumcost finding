class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        long res=(long)Math.max(need1,need2)*costBoth;
        long tes=(long)Math.min(need1,need2)*costBoth;
        if(need1>need2){
            tes+=(long)(need1-need2)*cost1;
        }
        else
            tes+=(long)(need2-need1)*cost2;
        
        long tes1=(long)need1*cost1+(long)need2*cost2;
        tes=Math.min(tes,tes1);
        return Math.min(res,tes);
    }
}
