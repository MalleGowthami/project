
class Solution {
    public int minDiff(Node root, int k) {
        
        int min = Integer.MAX_VALUE;
        
        while (root != null) {
            
            int diff = Math.abs(root.data - k);
            
            min = Math.min(min, diff);
            
            if (diff == 0) {
                return 0;
            }
            
            if (k < root.data) {
                root = root.left;
            } 
            else {
                root = root.right;
            }
        }
        
        return min;
    }
}
